# --- Base de datos ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ship_tracker
# Esquema donde vive todo (util para aislar pruebas)
DB_SCHEMA=public

# --- API ---
PORT=3000

# --- Ingesta AIS ---
# Proveedor activo. Cambiar de proveedor = cambiar SOLO esta capa (src/ingest/<provider>.js).
AIS_PROVIDER=aisstream
AISSTREAM_API_KEY=
AISSTREAM_URL=wss://stream.aisstream.io/v0/stream
# Bounding box global. Formato JSON: [[[lat_sw, lon_sw], [lat_ne, lon_ne]], ...]
AIS_BOUNDING_BOXES=[[[-90,-180],[90,180]]]
# Cuantas posiciones se acumulan antes de escribir en bloque
INGEST_BATCH_SIZE=200
INGEST_FLUSH_MS=5000
# Descarta posiciones mas cercanas que esto a la anterior del mismo buque (segundos).
# 0 = guardar todo lo que llegue.
INGEST_MIN_INTERVAL_S=60

# --- Retencion / particionado ---
RAW_RETENTION_DAYS=90
# Hora local (0-23) a la que corre la tarea diaria de mantenimiento
MAINTENANCE_HOUR=3
